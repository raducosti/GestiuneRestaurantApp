<Window x:Class="GestiuneRestaurantApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestiuneRestaurantApp.Views"
        mc:Ignorable="d"
        Title="Login"
        Height="450"
        Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Introduceți PIN-ul:"
                       FontSize="18"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBox Text="{Binding Pin}"
                     Width="200"
                     Height="40"
                     FontSize="24"
                     TextAlignment="Center"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <UniformGrid Columns="3"
                         Rows="4"
                         Width="200"
                         Height="250">

                <Button Content="1"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="1"/>

                <Button Content="2"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="2"/>

                <Button Content="3"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="3"/>

                <Button Content="4"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="4"/>

                <Button Content="5"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="5"/>

                <Button Content="6"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="6"/>

                <Button Content="7"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="7"/>

                <Button Content="8"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="8"/>

                <Button Content="9"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="9"/>

                <Button Content="C"
                        FontSize="20"
                        Margin="2"
                        Background="#FF6B6B"
                        Foreground="White"
                        Command="{Binding ClearPinCommand}"/>

                <Button Content="0"
                        FontSize="20"
                        Margin="2"
                        Command="{Binding AddDigitCommand}"
                        CommandParameter="0"/>

                <Button Content="OK"
                        FontSize="20"
                        Margin="2"
                        Background="#4CAF50"
                        Foreground="White"
                        Command="{Binding LoginCommand}"/>

            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
