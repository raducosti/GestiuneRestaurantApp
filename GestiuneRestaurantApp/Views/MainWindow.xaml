<Window x:Class="GestiuneRestaurantApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestiuneRestaurantApp.Views"
        xmlns:viewModels="clr-namespace:GestiuneRestaurantApp.ViewModels"
        Title="Gestiune Restaurant"
        Height="600"
        Width="1000">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:MeseViewModel}">
            <views:MeseView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ComandaViewModel}">
            <views:ComandaView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#2C3E50"
                Padding="12">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Gestiune Restaurant"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,20,0"/>

                <TextBlock Text="{Binding UserName}"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock Text=" - "
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding UserRole}"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>